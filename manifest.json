{
  "manifest_version": 3,
  "name": "GitHub Helper",
  "version": "2.0.1",
  "description": "GitHub を便利にします。コメント欄の隣の常時プレビュー、/imo などでのレビューバッジの挿入、PR 一覧の絞り込みボタン。",
  "permissions": [
    "storage"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "content.js",
        "pr-filters.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "css": [
        "content.css",
        "pr-filters.css"
      ]
    }
  ]
}
